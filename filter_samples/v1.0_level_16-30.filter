    Rarity == Unique
    SetFontSize 35
    SetTextColor 255 128 64 255
    SetBorderColor 255 128 64 255
    SetBackgroundColor 0 0 0 235
    PlayAlertSound 3 200
    PlayEffect Orange
    MinimapIcon 0 Orange Pentagon

